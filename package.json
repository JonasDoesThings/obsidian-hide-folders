{
	"name": "obsidian-hide-folders",
	"version": "1.5.3",
	"description": "ObsidianMD plugin that hides & toggles configured folders (e.g. attachments folders).",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && cp manifest.json dist",
		"build:testvault": "pnpm build && mkdir -p fixtures/obsidian-hide-folders-test-vault/.obsidian/plugins/obsidian-hide-folders && cp -r dist/* fixtures/obsidian-hide-folders-test-vault/.obsidian/plugins/obsidian-hide-folders",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"author": "jonasdoesthings.com",
	"repository": "https://github.com/JonasDoesThings/obsidian-hide-folders.git",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/JonasDoesThings/obsidian-hide-folders/issues"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.12.3",
		"builtin-modules": "4.0.0",
		"esbuild": "0.21.5",
		"eslint": "^10.3.0",
		"eslint-plugin-obsidianmd": "^0.2.9",
		"obsidian": "latest",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.59.2"
	},
	"packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
